# 本機開發：複製成 apps/web/.env.local（已在 .gitignore）。完整變數清單見 infra/.env.example。
# npm run db:start 會依 DATABASE_URL 的帳密與 port 建立本機 PostgreSQL 16。
DATABASE_URL=postgres://sok:sok_dev_password@localhost:54329/sok_studio
# 整合測試用；資料庫名稱必須以 _test 結尾（每次測試會整個重建）
TEST_DATABASE_URL=postgres://sok:sok_dev_password@localhost:54329/sok_studio_test
SCHEDULER_ENABLED=true
# DEV_DB_LOCALE=en-US              # 覆寫 initdb locale；不可用 C／POSIX（pg_trgm 對中日文失效）
