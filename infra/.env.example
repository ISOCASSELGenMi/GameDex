# SoK Game Calendar 環境變數（16 §環境變數）
# 正式環境：複製為 infra/.env 後填入。本機開發：見 apps/web/.env.example。
# 空字串視為未設。標「Phase N」的變數在該 Phase 才用到，現在留白即可。

# ── 核心 ─────────────────────────────────────────────
POSTGRES_PASSWORD=                  # 必填；用 URL 安全字元（openssl rand -hex 24），會被組進 DATABASE_URL
DATABASE_URL=                       # compose 內由 docker-compose.yml 覆寫成 postgres://sok:…@postgres:5432/sok_studio；本機開發才需要填
SITE_DOMAIN=                        # Caddy 用：網域本體，不含 https://，例：example.com（同時服務 www.<網域>）；compose 必填
NEXT_PUBLIC_SITE_URL=               # 完整網址，例：https://example.com。一旦有 iCal 訂閱者就不能改（UID 網域）；變更後要重新 build image
MODULES=                            # 未設 = accounts,discord,admin；none = 全停；notifications/awards/social 需明確列入
SUPPORTED_LOCALES=zh-Hant,en,ja
DEFAULT_LOCALE=zh-Hant
DEFAULT_REGION_PREF=WW
SCHEDULER_ENABLED=true
CATALOG_READ_TIMEOUT_MS=            # 選填：頁面查詢逾時（毫秒，預設見 read-tx.ts）

# ── IGDB（Phase 2）──────────────────────────────────
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=                 # 不可出現在前端
CALENDAR_VISIBLE_GAME_TYPES=main_game,standalone_expansion,remake,remaster,port
CALENDAR_VISIBLE_RELEASE_STAGES=unspecified,full,early_access
BACKFILL_LOOKBACK_YEARS=3
BACKFILL_MAX_REQ_PER_SEC=2
ROLLING_REFRESH_PER_NIGHT=10000
ICAL_PUBLIC_MAX_EVENTS=500          # 公開 releases.ics 事件上限（依熱度取前 N；見 docs/ical-prototype.md 的實測）
ICAL_PROTO_ENABLED=false            # true＝開啟 /ical/_proto/*（原型驗證用，驗證完關閉）

# ── 評分（Phase 4／6）───────────────────────────────
METACRITIC_SCRAPE_ENABLED=false     # Metacritic 唯一開關
RATING_DISPLAY_PRIORITY=metacritic_scrape,igdb
VISIBLE_SCORE_PROVIDERS=
PLAYER_RATING_MIN_COUNT=5

# ── 熱度與追蹤（Phase 3b／7）────────────────────────
HEAT_COLD_START_FOLLOWS=5000
FOLLOW_COUNT_MIN_DISPLAY=10
FOLLOW_MAX_PER_DAY=200

# ── 帳號（Phase 7）──────────────────────────────────
TOKEN_ENCRYPTION_KEY=               # 32 bytes 的 base64（openssl rand -base64 32）；加密 OAuth token；與資料庫分開保管。accounts 啟用時必填
AUTH_SECRET=                        # Better Auth 的 session／cookie 簽章與驗證信 JWT；≥ 32 字元高熵（openssl rand -base64 48）。accounts 啟用時必填
ACCOUNTS_SIGNUP_ENABLED=false        # 隱私權政策、刪除帳號、資料匯出完成前保持 false（09、D81）；false 時註冊端點與入口都不存在，既有帳號仍可登入
AUTH_TRUSTED_ORIGINS=                # 選填：額外可信來源（逗號分隔，例如 staging 網域）；預設只信任 NEXT_PUBLIC_SITE_URL
# 以下各組 *_CLIENT_ID／*_CLIENT_SECRET 兩者都有才啟用該登入方式。OAuth redirect URI：{站台}/api/v1/auth/callback/{discord|google|twitch|twitter|microsoft}
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=                   # 與 IGDB 憑證分開申請
TWITCH_CLIENT_SECRET=
TWITTER_CLIENT_ID=                  # 可行性未查證
TWITTER_CLIENT_SECRET=
STEAM_WEB_API_KEY=
MICROSOFT_CLIENT_ID=                # Microsoft 登入（Xbox 登入與匯入共用，provider 為 microsoft）
MICROSOFT_CLIENT_SECRET=

# ── Discord Bot（Phase 8）───────────────────────────
DISCORD_BOT_TOKEN=                  # 新的 Application，不是 TTS Bot
SITE_API_BASE=http://web:3000
INTERNAL_API_SECRET=                # discord 啟用時必填且 ≥ 32 字元

# ── 管理與回報（Slice 2 前）─────────────────────────
ADMIN_BASIC_AUTH_USER=              # admin 模組啟用（MODULES 預設含 admin）但兩者任一未設 → /internal/* 一律 404
ADMIN_BASIC_AUTH_PASS=              # 同時是管理介面 CSRF token 的金鑰來源；換密碼會使已開啟的頁面的表單失效
TURNSTILE_SITE_KEY=                 # 回報表單的人機驗證；開發可用 Cloudflare 官方測試金鑰 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=               # 開發測試金鑰 1x0000000000000000000000000000000AA（永遠通過）；production 未設 → 回報端點回 503
TURNSTILE_VERIFY_URL=               # 選填：siteverify 網址，預設 Cloudflare 官方；測試可指向本機假伺服器
REPORT_MAX_PER_IP_PER_DAY=10        # 每 IP（滾動 24 小時）回報上限
REPORT_IP_HASH_SECRET=              # ≥ 16 字元；回報者 IP 以 HMAC-SHA256 雜湊後保存 90 天；production 未設 → 回報端點回 503

# ── 通知（Phase 7.5）────────────────────────────────
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=
SMTP_HOST=                          # EMAIL_PROVIDER=smtp 時才需要（16 §環境變數：SMTP 另需 SMTP_*）
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFICATIONS_MAX_PER_USER_PER_DAY=1

# ── 營運（Phase 9）──────────────────────────────────
SENTRY_DSN=
ALERT_WEBHOOK_URL=                  # 任務心跳告警（每 10 分鐘檢查）與下架請求通知；Discord／Slack 相容 webhook。未設只寫 log
ANALYTICS_PROVIDER=                 # 流量分析（依選型；不用 cookie、不蒐集個資）
ANALYTICS_SITE_ID=
ANALYTICS_SCRIPT_URL=

# ── 備份（infra/backup/*.sh，系統 cron 執行，不經應用程式；也可改成行程環境變數）──
BACKUP_AGE_RECIPIENT=               # age 公鑰（age1…）；私鑰離線保管，不放 VM
BACKUP_RCLONE_REMOTE=               # rclone 目標，例：oci:sok-backups/prod（OCI Object Storage 的 S3 相容設定見 infra/backup/README.md）
BACKUP_PING_URL=                    # 選填：成功後 ping 的 dead man's switch 網址
BACKUP_KEEP_DAILY_DAYS=8            # 保留 7 天（多留 1 天避免邊界）
BACKUP_KEEP_WEEKLY_DAYS=29          # 4 週
BACKUP_KEEP_MONTHLY_DAYS=190        # 6 個月
