{
  "name": "sok-game-calendar",
  "private": true,
  "description": "SoK Studio Game Calendar — 遊戲資料庫＋上市月曆／時間軸（spec v2.0）",
  "workspaces": [
    "apps/*",
    "packages/*",
    "bots/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "db:start": "npm -w apps/web run db:start",
    "db:generate": "npm -w apps/web run db:generate",
    "db:migrate": "npm -w apps/web run db:migrate",
    "db:seed": "npm -w apps/web run db:seed",
    "job": "npm -w apps/web run job --",
    "lint": "npm -w apps/web run lint",
    "lint:arch": "npm -w apps/web run lint:arch",
    "typecheck": "npm -w apps/web run typecheck && npm -w packages/i18n run typecheck && npm -w packages/api-contract run typecheck",
    "test": "npm -w apps/web run test",
    "i18n:check": "npm -w apps/web run i18n:check"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true,
    "unrs-resolver@1.12.2": true
  }
}
